# Imagem base oficial do Python
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1

# Diretório de trabalho dentro do contentor
WORKDIR /app

# Dependências de sistema (compilação/uso do psycopg2)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Instalar as dependências Python (camada em cache enquanto o requirements não mudar)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copiar o código-fonte da API
COPY . .

# Porta em que o Flask escuta
EXPOSE 5000

# Comando de inicialização da API
CMD ["python", "app.py"]
